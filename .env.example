# MANU///LOGS — Environment Variables
# Phase 1: Local SQLite
DATABASE_URL=sqlite:///manu_logs.db
FLASK_ENV=development

# Google Sheets (keep until migration confirmed working)
SPREADSHEET_ID=your_sheet_id_here
CREDENTIALS_FILE=credentials.json

# Bot de Telegram (carga de entrenamientos por mensaje)
# Token: hablale a @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Tu user ID numerico: hablale a @userinfobot
# El bot ignora mensajes de cualquier otro ID
TELEGRAM_ALLOWED_USER_ID=your_numeric_user_id_here

# Claude API (parseo de los mensajes)
# Key: console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here

# Phase 2: Supabase (uncomment when ready)
# DATABASE_URL=postgresql://user:password@host:5432/manu_logs
