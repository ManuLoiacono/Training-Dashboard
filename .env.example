# MANU///LOGS — Environment Variables

# Base de datos. Fase 1: SQLite local.
DATABASE_URL=sqlite:///manu_logs.db
FLASK_ENV=development

# Fase 2: Supabase. Pega la connection string tal cual te la da
# Supabase (Settings -> Database -> Connection string -> URI):
#
#   DATABASE_URL=postgresql://postgres:TU_PASSWORD@host:5432/postgres
#
# No hace falta cambiarle el prefijo: models.py la reescribe sola a
# postgresql+psycopg:// para usar psycopg 3.
#
# Si te da "connection refused" o timeout, usa la string del POOLER en
# vez de la conexion directa: la directa es IPv6 y muchos ISP no la
# tienen. El pooler en modo transaction (puerto 6543) tambien esta
# contemplado — se le apagan los prepared statements solos.
#
# Para migrar los datos locales a Supabase:
#   python migrate_postgres.py --dry-run
#   python migrate_postgres.py

# Google Sheets (keep until migration confirmed working)
SPREADSHEET_ID=your_sheet_id_here
CREDENTIALS_FILE=credentials.json

# Bot de Telegram (carga de entrenamientos por mensaje)
# Token: hablale a @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Tu user ID numerico: hablale a @userinfobot
# El bot ignora mensajes de cualquier otro ID
TELEGRAM_ALLOWED_USER_ID=your_numeric_user_id_here

# Claude API (parseo de los mensajes)
# Key: console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here
